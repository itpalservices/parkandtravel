generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ParkingType {
  id       String    @id @db.VarChar(25)
  name     String    @db.VarChar(100)
  bookings Booking[]

  @@map("parking_types")
}

model PhoneCode {
  id        String    @id @default(uuid()) @db.Uuid
  isoCode   String    @db.VarChar(5)
  phoneCode String    @db.VarChar(10)
  bookings  Booking[]

  @@map("phone_codes")
}

model Booking {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String?      @db.VarChar(255)
  name         String       @db.VarChar(250)
  surname      String       @db.VarChar(250)
  email        String?      @db.VarChar(250)
  returnFlight String?      @db.VarChar(10)
  dateFrom     DateTime     @db.Date
  timeFrom     DateTime?    @db.Time(6)
  dateTo       DateTime?    @db.Date
  timeTo       DateTime?    @db.Time(6)
  mobile       String?      @db.VarChar(20)
  phoneCodeId  String?      @db.Uuid
  plateNo      String?      @db.VarChar(10)
  carBrand     String?      @db.VarChar(100)
  carModel     String?      @db.VarChar(100)
  carColor     String?      @db.VarChar(100)
  parkingTypeId String?     @db.VarChar(25)
  adults       Int?
  washService  Boolean      @default(false)
  finalPrice   Decimal?     @db.Decimal(10, 2)
  dropOffOption String?     @db.VarChar(20)
  pickUpOption  String?     @db.VarChar(20)
  bookingStatusId String?   @default("bookingStatus_created") @db.VarChar(50)
  parkPlace    String?      @db.VarChar(50)
  keepKeys     Boolean?     @default(false)
  mileageKm    Int?
  parkingComments String?   @db.Text
  actualCheckIn  DateTime?  @db.Timestamptz(6)
  actualCheckOut DateTime?  @db.Timestamptz(6)
  checkInBy      String?    @db.VarChar(255)
  checkOutBy     String?    @db.VarChar(255)
  extraFee             Decimal?   @db.Decimal(10, 2)
  estimatedArrivalTime DateTime?  @map("estimated_arrival_time") @db.Timestamptz(6)
  deleteflag           Int        @default(0)
  pendingWlTransactionId BigInt?  @map("pending_wl_transaction_id")
  createdAt            DateTime   @default(now())
  parkingType       ParkingType?       @relation(fields: [parkingTypeId], references: [id])
  phoneCode         PhoneCode?         @relation(fields: [phoneCodeId], references: [id])
  bookingStatus     BookingStatus?     @relation(fields: [bookingStatusId], references: [id])
  walleeTransactions     WalleeTransaction[]
  completionTransactions CompletionTransaction[]
  checkinTransactions    CheckinTransaction[]
  receipts               ReceiptHeader[]

  @@map("bookings")
}

model WalleeTransaction {
  id        BigInt   @id
  amount    Decimal  @db.Decimal(10, 2)
  bookingId String   @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id])

  @@map("wallee_transactions")
}

model CompletionTransaction {
  id            String   @id @default(uuid()) @db.Uuid
  bookingId     String   @map("booking_id") @db.Uuid
  datetime      DateTime @default(now()) @db.Timestamptz(6)
  amount        Decimal  @db.Decimal(10, 2)
  userId        String   @map("user_id") @db.VarChar(255)
  paymentMethod String   @map("payment_method") @db.VarChar(20)
  notes         String?  @db.Text
  shiftId       Int?     @map("shift_id")
  booking       Booking  @relation(fields: [bookingId], references: [id])
  shift         Shift?   @relation(fields: [shiftId], references: [id])

  @@map("completion_transactions")
}

model PendingBooking {
  id              String   @id @default(uuid()) @db.Uuid
  wlTransactionId BigInt?  @map("wl_transaction_id")
  formData        Json     @map("form_data")
  expiresAt       DateTime @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("pending_bookings")
}

model ConfigurationSetting {
  id    String  @id @db.VarChar(100)
  value String? @db.VarChar(500)

  @@map("configuration_settings")
}

model BookingStatus {
  id       String    @id @db.VarChar(50)
  value    String    @db.VarChar(100)
  bookings Booking[]

  @@map("booking_statuses")
}

model Shift {
  id             Int       @id @default(autoincrement())
  userId         String    @map("user_id") @db.VarChar(255)
  shiftStart     DateTime  @map("shift_start") @db.Timestamptz(6)
  shiftEnd       DateTime? @map("shift_end") @db.Timestamptz(6)
  lastActivityAt DateTime  @map("last_activity_at") @db.Timestamptz(6)
  status         String    @default("open") @db.VarChar(10)
  createdAt      DateTime  @default(now()) @map("created_at")

  completionTransactions CompletionTransaction[]
  checkinTransactions    CheckinTransaction[]

  @@index([userId], name: "idx_shifts_user_id")
  @@index([status], name: "idx_shifts_status")
  @@map("shifts")
}

model CheckinTransaction {
  id            String   @id @default(uuid()) @db.Uuid
  bookingId     String   @map("booking_id") @db.Uuid
  datetime      DateTime @default(now()) @db.Timestamptz(6)
  amount        Decimal  @db.Decimal(10, 2)
  userId        String   @map("user_id") @db.VarChar(255)
  paymentMethod String   @map("payment_method") @db.VarChar(20)
  notes         String?  @db.Text
  shiftId       Int?     @map("shift_id")
  booking       Booking  @relation(fields: [bookingId], references: [id])
  shift         Shift?   @relation(fields: [shiftId], references: [id])

  @@map("checkin_transactions")
}

model ReceiptHeader {
  id            String        @id @default(uuid()) @db.Uuid
  receiptSeq    Int           @default(autoincrement()) @unique @map("receipt_seq")
  receiptNumber String?       @unique @map("receipt_number") @db.VarChar(20)
  bookingId     String        @map("booking_id") @db.Uuid
  transactionId BigInt        @map("transaction_id")
  totalAmount   Decimal       @map("total_amount") @db.Decimal(10, 2)
  discount      Int?          @map("discount")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  booking       Booking       @relation(fields: [bookingId], references: [id])
  lines         ReceiptLine[]

  @@map("receipts_header")
}

model ReceiptLine {
  id          String        @id @default(uuid()) @db.Uuid
  receiptId   String        @map("receipt_id") @db.Uuid
  lineType    String        @map("line_type") @db.VarChar(20)
  description String        @db.VarChar(255)
  amount      Decimal       @db.Decimal(10, 2)
  receipt     ReceiptHeader @relation(fields: [receiptId], references: [id])

  @@map("receipts_lines")
}

model Car {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.VarChar(255)
  carBrand  String   @db.VarChar(100)
  carModel  String   @db.VarChar(100)
  carColor  String   @db.VarChar(100)
  plateNo   String   @db.VarChar(50)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("cars")
}
